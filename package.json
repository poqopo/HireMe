{
  "name": "hireme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gateway:dev": "node server/gateway/index.mjs",
    "gateway:smoke": "node scripts/smoke-gateway.mjs",
    "example:validate": "node scripts/validate-example-agent.mjs",
    "example:seal": "node scripts/seal-example-agent.mjs",
    "seal:inspect": "node scripts/inspect-seal-artifact.mjs",
    "seal:publish:walrus": "node scripts/publish-sealed-agent-to-walrus.mjs",
    "platform:encrypt": "node scripts/seal-example-agent.mjs",
    "platform:inspect": "node scripts/inspect-seal-artifact.mjs",
    "platform:publish:walrus": "node scripts/publish-sealed-agent-to-walrus.mjs",
    "memwal:publish": "node scripts/publish-memwal-snapshot.mjs",
    "memwal:read": "node scripts/read-memwal-snapshot.mjs",
    "example:seal:landing": "node scripts/seal-example-agent.mjs examples/landing-page-designer-agent",
    "example:run": "node scripts/validate-protected-artifact.mjs",
    "example:run:landing": "node scripts/validate-protected-artifact.mjs .hireme/artifacts/example-landing-designer.public-record.json",
    "example:smoke": "node scripts/smoke-protected-artifact.mjs",
    "example:smoke:landing": "node scripts/smoke-landing-designer.mjs",
    "demo": "npm run demo:agent-impact",
    "demo:agent-impact": "node scripts/demo-agent-impact.mjs",
    "walrus:publish:test1": "node scripts/publish-walrus-agent-folder.mjs examples/wal_test1 --agent-id wal-test1 --epochs 1",
    "walrus:read:test1": "node scripts/read-walrus-agent-folder.mjs --agent-id wal-test1 --task \"Describe this Walrus Agent folder\"",
    "sui:build": "sui move build --path move/hireme",
    "sui:test": "sui move test --path move/hireme",
    "sui:publish:hireme": "node scripts/publish-sui-hireme-package.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "plugin:smoke": "node scripts/smoke-hireme-plugin.mjs",
    "plugin:export": "node scripts/export-codex-plugin-repo.mjs",
    "supabase:seed": "node scripts/seed-supabase-demo.mjs",
    "supabase:smoke": "node scripts/smoke-supabase.mjs",
    "supabase:types": "supabase gen types --linked --schema public --lang typescript > src/types/database.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mysten/dapp-kit": "^1.1.0",
    "@mysten/enoki": "^1.1.0",
    "@mysten/sui": "^2.18.0",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tabs": "latest",
    "@supabase/supabase-js": "latest",
    "@tailwindcss/vite": "latest",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest"
  }
}
