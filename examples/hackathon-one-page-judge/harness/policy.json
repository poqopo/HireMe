{
  "schema": "hireme.harness_policy.v1",
  "agentId": "hackathon-one-page-judge",
  "privateAssets": [
    "AGENTS.md",
    "skills/**",
    "examples/private/**",
    "harness/**"
  ],
  "publicMetadata": [
    "public.json",
    "README.md",
    "examples/public/**"
  ],
  "outputBoundary": {
    "returnSafeResultsOnly": true,
    "neverReturn": [
      "raw AGENTS.md",
      "private rubric source",
      "private calibration notes",
      "harness policy internals",
      "eval sets",
      "backup keys"
    ]
  },
  "memWal": {
    "storeResultForHirer": true,
    "storeRawPrompt": false,
    "storeRawResponse": false
  }
}
