# Copy to .env and set only OPENAI_API_KEY for the local demo.
OPENAI_API_KEY=

# Optional: defaults to gpt-5.
HIREME_OPENAI_MODEL=gpt-5

# Optional local defaults.
HIREME_AGENT_HOST=127.0.0.1
HIREME_AGENT_PORT=8000
HIREME_MCP_TIMEOUT=50
HIREME_MCP_CONCURRENCY=4
HIREME_MCP_AGENT_CONCURRENCY=2

# Leave blank for localhost. Required only for a public deployment.
HIREME_MCP_TOKEN=

# Optional: public/private GitHub analysis support and crypto live mode.
# GITHUB_TOKEN=
# COINGECKO_DEMO_API_KEY=
