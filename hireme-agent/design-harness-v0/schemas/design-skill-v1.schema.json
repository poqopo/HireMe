{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hireme.dev/schemas/design-skill.v1.json",
  "title": "HireMe Design Skill Manifest v1",
  "type": "object",
  "required": ["schema", "id", "revision", "input", "capabilities", "outputs", "qualityGates", "graphBindings", "provenance"],
  "properties": {
    "schema": { "const": "hireme.design_skill.v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,80}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "input": {
      "type": "object",
      "required": ["requiredProjectFields"],
      "properties": {
        "requiredProjectFields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requiredAssetKinds": { "type": "array", "items": { "enum": ["logo", "image", "font", "color_token", "reference"] } }
      },
      "additionalProperties": false
    },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,80}$" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["kind", "format"], "properties": { "kind": { "enum": ["preview", "source", "export", "rationale"] }, "format": { "type": "string" } }, "additionalProperties": false } },
    "qualityGates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "graphBindings": {
      "type": "object",
      "required": ["nodeTypes"],
      "properties": {
        "nodeTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["intake", "analyze", "decide", "explore", "produce", "evaluate", "human_gate", "deliver"] } }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["origin", "evidenceRefs"],
      "properties": {
        "origin": { "enum": ["system_authoring", "design_starter", "creator"] },
        "baseSkillId": { "type": ["string", "null"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "approval": { "type": "object", "properties": { "requiredFor": { "type": "array", "items": { "enum": ["source_overwrite", "share", "publish"] } } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
