{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hireme.dev/schemas/skill-change-proposal.v1.json",
  "title": "HireMe Skill Change Proposal",
  "type": "object",
  "required": ["schema", "id", "agentId", "baseRevision", "status", "targetPath", "evidenceRefs", "expectedImpact", "candidateDigest"],
  "properties": {
    "schema": { "const": "hireme.skill_change_proposal.v1" },
    "id": { "type": "string" },
    "agentId": { "type": "string" },
    "baseRevision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["proposed", "approved", "rejected", "superseded"] },
    "targetPath": { "type": "string" },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "expectedImpact": { "type": "string" },
    "evaluationTask": { "type": "string", "minLength": 1 },
    "expectedIndicators": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "candidateDigest": { "type": "string", "pattern": "^sha256:" },
    "comparison": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
