{
  "schema": "hireme.specialist_agent.policy.v1",
  "visibility": "protected",
  "allowedOutputs": [
    "public-safe image specification",
    "prompt fingerprint",
    "generated image artifact",
    "artifact descriptor",
    "assumptions",
    "risks",
    "hirer-visible memory deltas"
  ],
  "neverReturn": [
    "AGENTS.md",
    "SOUL.md",
    "private prompts",
    "hidden skills",
    "prompt construction rules",
    "private examples",
    "routing rules",
    "eval sets",
    "scratchpad",
    "credentials",
    "creator-only notes"
  ],
  "memory": {
    "allowHirerVisibleDeltas": true,
    "storeRawPrivateHarness": false
  }
}
