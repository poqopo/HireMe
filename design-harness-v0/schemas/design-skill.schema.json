{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hireme.dev/schemas/design-skill.v0.json",
  "title": "HireMe Design Skill Manifest",
  "type": "object",
  "required": ["schema", "id", "revision", "input", "capabilities", "outputs", "qualityGates"],
  "properties": {
    "schema": { "const": "hireme.design_skill.v0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,80}$" },
    "revision": { "type": "string", "pattern": "^v[0-9]+$" },
    "input": { "type": "object", "required": ["requiredProjectFields"], "properties": { "requiredProjectFields": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "requiredAssetKinds": { "type": "array", "items": { "enum": ["logo", "image", "font", "color_token", "reference"] } } } },
    "capabilities": { "type": "array", "minItems": 1, "items": { "enum": ["asset.inspect", "brand.validate", "reference.search", "image.generate", "image.edit", "layout.compose", "file.export"] }, "uniqueItems": true },
    "outputs": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["kind", "format"], "properties": { "kind": { "enum": ["preview", "source", "export", "rationale"] }, "format": { "type": "string" } } } },
    "qualityGates": { "type": "array", "minItems": 1, "items": { "enum": ["brief_fidelity", "brand_consistency", "technical_delivery", "policy_safety"] }, "uniqueItems": true },
    "approval": { "type": "object", "properties": { "requiredFor": { "type": "array", "items": { "enum": ["source_overwrite", "share", "publish"] } } } }
  },
  "additionalProperties": false
}
