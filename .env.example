# Local Agent runtime
HIREME_AGENT_PROVIDER=codex
HIREME_LOCAL_SPECIALIST_ROOT=examples/local-specialist-agents
HIREME_USER_ID=local-dev-user
HIREME_CONFIG=

# Optional provider overrides
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
