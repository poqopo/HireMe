OLLAMA_MODEL=

# Native OpenAI Codex OAuth image provider
HIREME_CODEX_IMAGE_GEN_COMMAND=
HIREME_CODEX_IMAGE_GEN_ARGS=
HIREME_CODEX_IMAGE_GEN_TIMEOUT_MS=120000

# HireMe account and Google login
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
HIREME_SUPABASE_URL=
HIREME_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=
HIREME_GOOGLE_CLIENT_ID=
HIREME_GOOGLE_CLIENT_SECRET=
